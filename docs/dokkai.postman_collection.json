            "body": {
              "mode": "raw",
              "raw": "{\n  \"repo_path\": \"{{repoPath}}\",\n  \"recreate\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/instances/pipeline",
              "host": ["{{baseUrl}}"],
              "path": ["instances", "pipeline"]
            },
            "description": "DANGER: recreate:true drops the ENTIRE collection (all projects) before inserting. Use only once, after a schema change."
          },
          "response": []
