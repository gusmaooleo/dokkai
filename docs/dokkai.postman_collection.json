              "host": ["{{baseUrl}}"],
              "path": ["chat", "conversations", "{{conversationId}}"]
            },
            "description": "Full history (messages + their sources) for one conversation."
          },
          "response": []
        },
        {
          "name": "Delete conversation",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/chat/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["chat", "conversations", "{{conversationId}}"]
            },
            "description": "Delete a conversation and its history."
          },
          "response": []
        }
      ]
    },
    {
      "name": "Graph",
      "item": [
        {
          "name": "List graphs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graph",
              "host": ["{{baseUrl}}"],
              "path": ["graph"]
            },
            "description": "List every project with an ingested graph in ingested/. Returns [] when nothing has been ingested yet. Restart-proof -- read straight off the filesystem."
          },
          "response": []
        },
        {
          "name": "Get project graph (code entities)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graph/{{projectName}}?limit=5000",
              "host": ["{{baseUrl}}"],
              "path": ["graph", "{{projectName}}"],
              "query": [{ "key": "limit", "value": "5000" }]
            },
            "description": "Normalized graph for the project: code-entity nodes (Class/Function/Method/Interface/Enum/Type) and edges among them only. 404 if the project was never ingested."
          },
          "response": []
        },
        {
          "name": "Get project graph (structural)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graph/{{projectName}}?include=structural&limit=5000",
              "host": ["{{baseUrl}}"],
              "path": ["graph", "{{projectName}}"],
              "query": [
                { "key": "include", "value": "structural" },
                { "key": "limit", "value": "5000" }
              ]
            },
            "description": "Every node (code entities, folders, files, modules, packages, the project, external packages) and every edge, up to limit."
          },
          "response": []
        },
        {
          "name": "Get entity neighborhood",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graph/{{projectName}}/neighborhood?entity={{entityQualifiedName}}&depth=1&direction=both&limit=200",
              "host": ["{{baseUrl}}"],
              "path": ["graph", "{{projectName}}", "neighborhood"],
              "query": [
                { "key": "entity", "value": "{{entityQualifiedName}}" },
                { "key": "depth", "value": "1" },
                { "key": "direction", "value": "both" },
                { "key": "limit", "value": "200" }
              ]
            },
            "description": "BFS over CALLS/INHERITS/IMPLEMENTS/OVERRIDES/DEFINES/DEFINES_METHOD edges only (never IMPORTS or containment/external edges). Nodes carry hop (0 = center); the center is also returned separately. 404 if the project has no graph, or if entity isn't in it."
          },
          "response": []
        },
        {
          "name": "Get file dependency view",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/graph/{{projectName}}/files",
              "host": ["{{baseUrl}}"],
              "path": ["graph", "{{projectName}}", "files"]
            },
            "description": "Directed file-to-file dependency aggregation, internal files only (external packages/modules excluded, self-loops skipped). Each edge has a total weight and a per relationship-type types breakdown."
          },
          "response": []
        }
      ]
    },
