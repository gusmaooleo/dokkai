        {
          "name": "Start pipeline (no descriptions)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repo_path\": \"{{repoPath}}\",\n  \"recreate\": false,\n  \"describe\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/instances/pipeline",
              "host": ["{{baseUrl}}"],
              "path": ["instances", "pipeline"]
            },
            "description": "describe:false opts out of per-entity LLM descriptions for this run. Skips the descriptor pre-flight (no 400 even if DESC_MODEL is unset/unpulled) and ingests without descriptions -- the summary named vector stays empty for this project's chunks (equivalent to `dokkai ingest --no-describe`)."
          },
          "response": []
        },
        {
          "name": "Start graph-only run",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.job_id) {",
                  "  pm.collectionVariables.set('jobId', res.job_id);",
                  "  console.log('Saved jobId =', res.job_id);",
                  "}",
                  "pm.test('job queued', function () {",
                  "  pm.expect(res).to.have.property('job_id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"repo_path\": \"{{repoPath}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/instances/graph",
              "host": ["{{baseUrl}}"],
              "path": ["instances", "graph"]
            },
            "description": "Enqueue a graph-ONLY run (cgr only -- no chunking, no LLM descriptions, no embedding, no Weaviate). Returns { job_id, status } immediately; runs in the background with stages cgr -> done and kind: \"graph\". result.ingest.output_json is the same canonical graph JSON path (ingested/<project>.json) the full pipeline produces, readable by the Graph API as soon as the job succeeds. Shares the same per-project job lock as Start pipeline / Refresh descriptions. The test script saves job_id into {{jobId}}."
          },
          "response": [
            {
              "name": "409 - job already running",
              "originalRequest": {
                "method": "POST",
                "header": [{ "key": "Content-Type", "value": "application/json" }],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"repo_path\": \"{{repoPath}}\"\n}"
                },
                "url": {
                  "raw": "{{baseUrl}}/instances/graph",
                  "host": ["{{baseUrl}}"],
                  "path": ["instances", "graph"]
                }
              },
              "status": "Conflict",
              "code": 409,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"detail\": \"another job is running for project 'your-repo'\"\n}"
            }
          ]
        },
        {
          "name": "List jobs",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instances/jobs",
              "host": ["{{baseUrl}}"],
              "path": ["instances", "jobs"]
            },
            "description": "List all ingestion jobs, most recent first. In-memory; resets on server restart."
          },
          "response": []
        },
        {
          "name": "Get job",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/instances/jobs/{{jobId}}",
              "host": ["{{baseUrl}}"],
              "path": ["instances", "jobs", "{{jobId}}"]
            },
            "description": "Poll a job's progress. Watch stage (cgr -> chunk -> describe -> upsert -> done for pipeline jobs, chunk -> describe -> update -> done for refresh jobs, cgr -> done for graph-only jobs), stage_progress {stage,done,total}, kind (pipeline|refresh|graph), and result.vectorize.descriptions (pipeline) or result.descriptions (refresh) -- graph-only jobs' result has only ingest.output_json."
          },
          "response": []
        },
        {
          "name": "Job events (SSE)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "text/event-stream" }],
            "url": {
              "raw": "{{baseUrl}}/instances/jobs/{{jobId}}/events",
              "host": ["{{baseUrl}}"],
              "path": ["instances", "jobs", "{{jobId}}", "events"]
            },
            "description": "Streams the job's progress as Server-Sent Events, mirroring Chat (SSE)'s framing. Emits the current state on connect, then again whenever updated_at changes (~0.5s poll). event: job for in-progress updates, event: done for the terminal state (status = succeeded|failed), after which the stream closes. Each event's data is the same Job object as GET /instances/jobs/{id}. Unknown job_id -> plain 404 (not a stream).\n\nNote: Postman buffers the stream and shows it after completion; use curl -N for live events."
          },
          "response": []
        },
