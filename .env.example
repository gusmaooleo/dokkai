# Postgres connection (conversation history)
DATABASE_URL=postgresql://dokkai:dokkai@localhost:5432/dokkai

# Weaviate connection
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
COLLECTION_NAME=CodeEntity

# Vectorizer / embeddings — local (ollama) by default. openai/cohere send
# every chunk's raw source code and description to that provider for
# embedding (with the key below forwarded to it) — configured entirely
# separately from, and unaffected by, DESC_PROVIDER/config/providers.json
# below (see "LLM providers" in the README).
# VECTORIZER_PROVIDER: ollama | openai | cohere | local
VECTORIZER_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# Ollama URL as seen by the Weaviate server (Docker -> host)
OLLAMA_EMBED_ENDPOINT=http://host.docker.internal:11434
# Required when VECTORIZER_PROVIDER=openai, or (same var) when
# DESC_PROVIDER=openai below and DESC_API_KEY isn't set
OPENAI_API_KEY=sk-...
# Only required when VECTORIZER_PROVIDER=cohere
COHERE_API_KEY=...
# Only required when DESC_PROVIDER=gemini below and DESC_API_KEY isn't set.
# NOTE: the /config/llm chat path does NOT read this var — POST /config/llm
# always requires provider_data.key in the request body for gemini, even if
# this is set.
GEMINI_API_KEY=...

# Ollama chat (LLM provider)
# Ollama URL as seen by the API process (chat)
OLLAMA_BASE_URL=http://localhost:11434
# If set: auto-configure + warm this chat model on boot
OLLAMA_CHAT_MODEL=
OLLAMA_NUM_CTX=8192
# httpx read timeout, in seconds (covers cold model loads)
OLLAMA_TIMEOUT=600
# Keep model resident: -1 = forever, or a duration like 30m
OLLAMA_KEEP_ALIVE=-1

# Description generation
DESC_MODEL=qwen2.5-coder:3b
DESC_CONCURRENCY=4
# DESC_PROVIDER: ollama (default, local) | a built-in remote id (openai,
# gemini, anthropic) | any id registered in config/providers.json | a
# custom id paired with DESC_BASE_URL. See "LLM providers" in the README.
DESC_PROVIDER=ollama
# Only required for a custom (unregistered) DESC_PROVIDER id — e.g.
# http://localhost:1234/v1 for a local LM Studio/vLLM server. Overrides a
# registered provider's own base URL when set.
# DESC_BASE_URL=
# Descriptor-only API key override — takes precedence over the provider's
# own key env var (OPENAI_API_KEY/GEMINI_API_KEY/ANTHROPIC_API_KEY above,
# or a file-registered provider's own key below).
# DESC_API_KEY=
# Only required when DESC_PROVIDER=anthropic and DESC_API_KEY isn't set
ANTHROPIC_API_KEY=sk-ant-...

# Provider registry — register any other provider (id, api shape, baseUrl,
# apiKey, models) beyond the built-ins above, no code change. See
# config/providers.example.json and "LLM providers" in the README. Absent
# = no-op. Overridable path:
# DOKKAI_PROVIDERS_FILE=config/providers.json

# Graph extraction
# Image used by cgr (shell/run_cgr.sh) for graph extraction
MEMGRAPH_IMAGE=memgraph/memgraph:latest
# When set, shell/run_cgr.sh connects to this resident Memgraph host (e.g.
# the `memgraph` compose service) instead of starting an ephemeral
# container per run. dev.sh defaults this to localhost. Unset to use the
# legacy ephemeral-container flow.
MEMGRAPH_HOST=localhost

# Authentication (optional — admin/admin is seeded automatically when unset)
# Overrides the seeded admin user's username/password on boot; also re-applied
# (and invalidates that user's sessions) if changed on a later boot.
DOKKAI_ROOT_USER=admin
DOKKAI_ROOT_PASSWORD=admin

# CORS — comma-separated list of allowed frontend origins
DOKKAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Containerized API only (docker-compose.yml `full` profile / `dokkai up
# --full`). The parent directory of the repos you want to ingest/review —
# bind-mounted into the api container at the SAME path, so repo_path values
# match a host ./dev.sh run. Example: if your repos live under
# /Users/you/projects/*, set this to /Users/you/projects.
DOKKAI_REPOS_DIR=/Users/you/projects
