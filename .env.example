# Postgres connection (conversation history)
DATABASE_URL=postgresql://dokkai:dokkai@localhost:5432/dokkai

# Weaviate connection
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8080
WEAVIATE_GRPC_PORT=50051
COLLECTION_NAME=CodeEntity

# Vectorizer / embeddings
# VECTORIZER_PROVIDER: ollama | openai | cohere | local
VECTORIZER_PROVIDER=ollama
EMBED_MODEL=nomic-embed-text
# Ollama URL as seen by the Weaviate server (Docker -> host)
OLLAMA_EMBED_ENDPOINT=http://host.docker.internal:11434
# Only required when VECTORIZER_PROVIDER=openai
OPENAI_API_KEY=sk-...
# Only required when VECTORIZER_PROVIDER=cohere
COHERE_API_KEY=...

# Ollama chat (LLM provider)
# Ollama URL as seen by the API process (chat)
OLLAMA_BASE_URL=http://localhost:11434
# If set: auto-configure + warm this chat model on boot
OLLAMA_CHAT_MODEL=
OLLAMA_NUM_CTX=8192
# httpx read timeout, in seconds (covers cold model loads)
OLLAMA_TIMEOUT=600
# Keep model resident: -1 = forever, or a duration like 30m
OLLAMA_KEEP_ALIVE=-1

# Description generation
DESC_MODEL=qwen2.5-coder:3b
DESC_CONCURRENCY=4
# DESC_PROVIDER: ollama | openai | anthropic
DESC_PROVIDER=ollama
# Only required when DESC_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Graph extraction
# Image used by cgr (shell/run_cgr.sh) for graph extraction
MEMGRAPH_IMAGE=memgraph/memgraph:latest
# When set, shell/run_cgr.sh connects to this resident Memgraph host (e.g.
# the `memgraph` compose service) instead of starting an ephemeral
# container per run. dev.sh defaults this to localhost. Unset to use the
# legacy ephemeral-container flow.
MEMGRAPH_HOST=localhost

# Authentication (optional — admin/admin is seeded automatically when unset)
# Overrides the seeded admin user's username/password on boot; also re-applied
# (and invalidates that user's sessions) if changed on a later boot.
DOKKAI_ROOT_USER=admin
DOKKAI_ROOT_PASSWORD=admin

# CORS — comma-separated list of allowed frontend origins
DOKKAI_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
